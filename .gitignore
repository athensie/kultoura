# OS
Thumbs.db
ehthumbs.db
Desktop.ini

# IDEs
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# PHP / Composer
vendor/
composer.lock
.env
.env.local
.env.*.local

# Secrets (real API keys — copy config/gemini.example.php to config/gemini.php and fill it in)
config/gemini.php

# One-time admin bootstrap script — reads credentials from env vars,
# never hardcode real ones here (see config/createadmin.php's header)
config/createadmin.php

# Node
node_modules/

# Logs
logs/
*.log

# Runtime / cache
cache/
tmp/
*.cache

# Uploads (user content) — except the .htaccess that blocks executing
# anything an attacker manages to sneak past the upload validators.
# (Ignoring contents with /* rather than the bare directory name lets
# the negation below actually apply — git won't re-include a file
# whose parent directory itself was excluded.)
assets/uploads/*
!assets/uploads/.htaccess

# XAMPP
xamppfiles/

# Misc
.DS_Store
